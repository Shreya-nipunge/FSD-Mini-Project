# Copy this file to .env and fill in your values.
# Do NOT commit your actual .env file to version control.

# Optional Express API root for direct development/deployment requests; Vite proxies to port 5000 by default.
VITE_API_URL=
# Optional legacy FastAPI API root when CSV upload is enabled outside Vite development.
VITE_LEGACY_API_URL=

# NewsAPI key — get one at https://newsapi.org/
NEWS_API_KEY=your_newsapi_key_here

# JWT Secret — use a long random string in production
JWT_SECRET=your_long_random_jwt_secret_here

# Express API server
PORT=5000
HOST=127.0.0.1
NODE_ENV=development

# Allowed browser origin for the Vite frontend (comma-separated if needed)
CLIENT_ORIGIN=http://localhost:5173

# PostgreSQL connection. Use either DATABASE_URL or the individual PG_* values.
# Do not commit real credentials. Configure the same variables in the deployment environment.
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/crimemap
# The demo seed requires locally chosen passwords; these placeholders are not usable credentials.
DEMO_USER_PASSWORD=replace_with_local_demo_user_password
DEMO_ADMIN_PASSWORD=replace_with_local_demo_admin_password
# PG_HOST=localhost
# PG_PORT=5432
# PG_DATABASE=crimemap
# PG_USER=postgres
# PG_PASSWORD=your_password
# PG_SSL=false
